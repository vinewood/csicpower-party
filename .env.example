# 环境变量配置示例
# 复制此文件为 .env 并填入真实配置

# ============ 应用配置 ============
# 调试模式（生产环境设为 False）
DEBUG=True

# 应用监听地址
HOST=0.0.0.0
PORT=8000

# ============ 数据库配置 ============
# MySQL连接字符串
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/csic_ai

# ============ Redis配置 ============
# Redis连接字符串
REDIS_URL=redis://localhost:6379

# ============ JWT认证配置 ============
# JWT密钥（生产环境请使用强随机密钥）
# 生成方法：openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT算法
JWT_ALGORITHM=HS256

# Access Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh Token过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ 阿里云百炼配置 ============
# 百炼API Key
BAILIAN_API_KEY=your-bailian-api-key-here

# 百炼工作空间ID
BAILIAN_WORKSPACE_ID=your-workspace-id-here

# 百炼知识库ID（可选）
BAILIAN_KB_ID=your-knowledge-base-id-here

# ============ DeepSeek配置（备用模型） ============
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============ AMiner API配置（科研文献） ============
AMINER_API_KEY=your-aminer-api-key-here

# ============ 文件上传配置 ============
# 上传文件存储路径
UPLOAD_DIR=./uploads

# 最大上传文件大小（字节，默认500MB）
MAX_UPLOAD_SIZE=524288000

# 允许上传的文件类型
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.mp4,.mov,.avi,.mkv,.txt,.md

# ============ Celery配置 ============
# Celery任务结果过期时间（秒）
CELERY_RESULT_EXPIRES=3600

# ============ 日志配置 ============
# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径（为空则输出到控制台）
LOG_FILE=

# ============ RSS订阅配置 ============
# RSSHub服务地址
RSSHUB_URL=http://localhost:1200

# 新闻抓取间隔（小时）
NEWS_FETCH_INTERVAL=6

# ============ 安全配置 ============
# CORS允许的域名（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 登录失败最大尝试次数
MAX_LOGIN_ATTEMPTS=5

# 锁定时间（分钟）
LOCKOUT_DURATION=30
